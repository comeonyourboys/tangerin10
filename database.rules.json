{
  "rules": {
    ".read": false,
    ".write": false,
    "rankings": {
      ".read": true,
      ".indexOn": ["score"],
      "$entry": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'score', 'date'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && !newData.val().matches(/[<>\"'`&\\\\\\/=]/)"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 850 && newData.val() % 1 === 0"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
