{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
      { "source": "**/*.@(png|jpg|svg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml" }] },
      { "source": "ads.txt", "headers": [{ "key": "Content-Type", "value": "text/plain" }] }
    ]
  }
}
